# apps/server
CAMP_PORT=8787
# fixture | gemini
#   fixture：固定データだけ（GCP の権限いらず）
#   gemini ：Gemini と固定データの両方を選べる（既定は Gemini。開始画面・ヘッダーで切り替え）。失敗時は自動で固定データ
AI_GATEWAY=fixture
# 固定データの疑似待ち時間（ミリ秒）
FIXTURE_LATENCY_MS=900
# 下段の自動入れ替え（注目度ベース、docs/adr/ADR-0006）。off で無効
ROTATION=on
# ROTATION_CHECK_MS=1000        確認の間隔
# ROTATION_WARNING_MS=10000     退場予告（カウントダウン）から退場まで
# ROTATION_MIN_GAP_MS=6000      退場予告どうしの最短間隔
# ROTATION_MAX_CONCURRENT=2     同時にカウントダウンする案の数
# ROTATION_MIN_STAGE_MS=10000   登場してから退場候補になるまで
# ROTATION_IDLE_MS=6000         注目度0の案が退場候補になる「触れられていない時間」
# ROTATION_IDLE_PER_SCORE_MS=4000  注目度1あたりの猶予
# ROTATION_MAX_IDLE_MS=30000
# ROTATION_HALF_LIFE_MS=30000   注目度が半分になる時間

# --- Gemini（Vertex AI）。APIキーは使わない ---
# GOOGLE_CLOUD_PROJECT=idea-audition
# GOOGLE_CLOUD_LOCATION=global
# ローカル開発専用：gcloud の設定名。その設定のログインでトークンを取得する（ADC を上書きしない）
# LOCAL_GCLOUD_CONFIG=victory
# GEMINI_MODEL_FAST=gemini-3.5-flash
# GEMINI_THINKING_FAST=MINIMAL
# GEMINI_MODEL_REFINE=gemini-3.8-flash
# GEMINI_THINKING_REFINE=LOW
# 企画書の画像。既定は gemini-3.1-flash-lite-image（off で作らない）
# GEMINI_MODEL_IMAGE=gemini-3.1-flash-lite-image
# GEMINI_TIMEOUT_FAST_MS=12000
# GEMINI_TIMEOUT_REFINE_MS=25000
# GEMINI_TIMEOUT_IMAGE_MS=25000

# --- 音声入力（Gemini Live）。AI_GATEWAY=gemini のときだけ有効 ---
# VOICE=on
# 声の発言を AI で仕分け・言い直しする。雑談・アプリの話・聞き間違いは捨て、残った発言だけを言い直して記録・AI・キャラに渡す（画面には出さない）。off で無効（聞こえたままを使う）
# UTTERANCE_TRIAGE=on
# GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live
# GEMINI_LIVE_LOCATION=global

# --- 永続化 ---
# none | firestore
PERSISTENCE=none
# 手元で firestore を使うときは必ず開発用のデータベースに向ける（本番は (default)）
# FIRESTORE_DATABASE=dev-local

# apps/web（本番ビルド時のみ。開発時は Vite のプロキシを使う）
# VITE_CAMP_URL=wss://<cloud-run-host>/camp

# --- 通話の中継（Cloudflare の TURN）。直接つながらない回線（テザリング・大学や会社の Wi-Fi）でも声が届くようにする ---
# Cloudflare のダッシュボード → Realtime → TURN Server で作ったキー。サーバーだけが持ち、ブラウザには数時間で切れる接続情報だけを渡す
# 無ければ Google の STUN だけで通話する。本番は Secret Manager から渡す（docs/05-platform/deployment.md）
# TURN_KEY_ID=
# TURN_KEY_API_TOKEN=
